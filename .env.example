# Copy to .env and fill in what you have. Every value has a working default,
# so the project runs end-to-end with this file completely empty.

# ---- location ----
AQI_CITY=Karachi
AQI_COUNTRY=PK
AQI_LAT=24.8607
AQI_LON=67.0011
AQI_TIMEZONE=UTC

# ---- data source ----
# auto | openweather | openmeteo
# `auto` uses OpenWeather when a key is present and Open-Meteo otherwise.
AQI_DATA_SOURCE=auto
OPENWEATHER_API_KEY=
AQICN_TOKEN=

# ---- feature store / model registry ----
# auto | hopsworks | local
# `auto` uses Hopsworks when both values below are set, else local Parquet.
AQI_FEATURE_STORE=auto
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# ---- modelling ----
AQI_BACKFILL_DAYS=365
AQI_TEST_HOURS=504

# ---- alerting ----
# 150 = "Unhealthy" on the EPA scale.
AQI_ALERT_THRESHOLD=150
# Slack or Discord incoming webhook; leave blank to log alerts only.
AQI_ALERT_WEBHOOK=

# ---- serving ----
AQI_API_PORT=5000
GRAFANA_PASSWORD=admin
